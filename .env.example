# Copy to .env for development or Compose's non-secret deployment settings.
# Production secret values belong in files under PLATEOS_SECRETS_DIR, not here.

# --- Compose deployment (non-secret) ---
PLATEOS_IMAGE_TAG=development
PLATEOS_PORT=8080
PLATEOS_SECRETS_DIR=/path/outside/checkout/plateos-secrets
PLATEOS_SECRETS_GID=2000
PLATEOS_BACKUP_DIR=/path/outside/checkout/plateos-backups
PLATEOS_BACKUP_UID=1000
PLATEOS_BACKUP_GID=1000
# Worker-only VAPID private key file. Keep it outside PLATEOS_SECRETS_DIR so
# the API's directory mount can never read the private key.
PLATEOS_PUSH_PRIVATE_KEY_FILE=/path/outside/checkout/plateos-push-private-key

# --- Application runtime ---
# docker-compose.yml overrides this to production and forces Secure cookies.
PLATEOS_ENVIRONMENT=development
PLATEOS_PROCESS_ROLE=api
PLATEOS_MAX_REQUEST_BODY_BYTES=2000000
# Settings-screen overrides (providers/models/keys/OFF URL) live in this JSON
# file, outside the database and therefore outside encrypted DB backups.
PLATEOS_RUNTIME_SETTINGS_FILE=data/runtime-settings.json

# --- Web Push (D41) ---
# Production reads plateos_web_push_public_key,
# plateos_web_push_subscription_key, and plateos_web_push_vapid_subject from
# PLATEOS_SECRETS_DIR. The worker alone mounts PLATEOS_PUSH_PRIVATE_KEY_FILE as
# plateos_web_push_private_key. Generate the subscription key with
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`.
# Generate a PEM private key with `vapid --gen`; put that file at
# PLATEOS_PUSH_PRIVATE_KEY_FILE and put `vapid --applicationServerKey` output in
# plateos_web_push_public_key.
# These environment values are for development only.
PLATEOS_WEB_PUSH_PUBLIC_KEY=
PLATEOS_WEB_PUSH_PRIVATE_KEY=
PLATEOS_WEB_PUSH_SUBSCRIPTION_KEY=
PLATEOS_WEB_PUSH_VAPID_SUBJECT=mailto:operator@example.invalid
PLATEOS_WEB_PUSH_POLL_SECONDS=15
PLATEOS_WEB_PUSH_BATCH_SIZE=25
PLATEOS_WEB_PUSH_LEASE_SECONDS=60
PLATEOS_WEB_PUSH_REQUEST_TIMEOUT_SECONDS=15
PLATEOS_WEB_PUSH_MAX_ATTEMPTS=5
PLATEOS_WEB_PUSH_RETRY_BASE_SECONDS=30
PLATEOS_WEB_PUSH_RETRY_MAX_SECONDS=3600

# --- Database ---
# Direct URL is convenient for workstation development. Production Compose uses
# the component fields and /run/secrets/plateos_database_password instead.
PLATEOS_DATABASE_URL=postgresql+asyncpg://plateos:plateos@localhost:5432/plateos
PLATEOS_DATABASE_HOST=localhost
PLATEOS_DATABASE_PORT=5432
PLATEOS_DATABASE_USER=plateos
PLATEOS_DATABASE_PASSWORD=plateos
PLATEOS_DATABASE_NAME=plateos
POSTGRES_USER=plateos
POSTGRES_DB=plateos

# --- LLM gateway (OpenAI-compatible; decision D5) ---
# OpenAI:            https://api.openai.com/v1
# Gemini (compat):   https://generativelanguage.googleapis.com/v1beta/openai
# Ollama (local):    http://localhost:11434/v1   (model e.g. qwen2.5vl:7b)
PLATEOS_LLM_BASE_URL=https://api.openai.com/v1
PLATEOS_LLM_API_KEY=
PLATEOS_LLM_MODEL=gpt-4o-mini

# --- Open Food Facts ---
PLATEOS_OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org/api/v2

# --- Auth (single user; decision D6) ---
# These values are development-only. Production reads files named
# plateos_app_password and plateos_session_secret from PLATEOS_SECRETS_DIR.
PLATEOS_APP_PASSWORD=changeme
# Username of the bootstrap admin account (decision D36).
PLATEOS_ADMIN_USERNAME=admin
PLATEOS_SESSION_SECRET=generate-a-long-random-string
# Set to true when served behind TLS (homelab reverse proxy)
PLATEOS_COOKIE_SECURE=false
# Optional static API token for Apple Shortcuts / external automation.
# Sent as "Authorization: Bearer <token>" — grants full API access.
PLATEOS_API_TOKEN=

# --- Profile seed defaults ---
PLATEOS_DEFAULT_USER_TIMEZONE=Europe/Lisbon
PLATEOS_DEFAULT_WEIGHT_KG=75
PLATEOS_DEFAULT_HEIGHT_CM=178
